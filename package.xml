<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>testudo</name>
  <version>1.0.0</version>
  <description>Diagnostics dashboard for ROS 2 navigation stacks: watches every topic from the outside and points at what broke.</description>
  <maintainer email="elechim2196@gmail.com">mlisi1</maintainer>
  <license>Apache-2.0</license>

  <url type="website">https://mlisi1.github.io/testudo/</url>
  <url type="repository">https://github.com/mlisi1/testudo</url>
  <url type="bugtracker">https://github.com/mlisi1/testudo/issues</url>

  <depend>rclpy</depend>
  <depend>rcl_interfaces</depend>
  <depend>diagnostic_msgs</depend>
  <depend>lifecycle_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>sensor_msgs_py</depend>
  <depend>geometry_msgs</depend>
  <depend>action_msgs</depend>
  <depend>tf2_msgs</depend>
  <depend>ament_index_python</depend>
  <depend>rosidl_runtime_py</depend>

  <exec_depend>python3-yaml</exec_depend>
  <!-- launch/testudo.launch.py -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-psutil</exec_depend>
  <!-- GPU memory profiling (node_profiling.gpu_enabled) is best-effort and
       NVIDIA-only via pynvml/nvidia-ml-py, which has no rosdep key and is
       imported lazily (pip-install it yourself if you want it); node
       profiling degrades to no-GPU-data (not an error) without it. -->
  <!-- Only needed for `testudo replay`; imported lazily so other commands
       don't require it. -->
  <exec_depend>rosbag2_py</exec_depend>
  <!-- Only the dashboard needs it, and it needs Textual 6 or newer: on Ubuntu
       24.04 rosdep resolves this to 0.1.13. `testudo watch` checks the
       version at startup and says what to pip install
       (testudo/tui/requirement.py); headless and replay work without it. -->
  <exec_depend>python3-textual</exec_depend>

  <test_depend>python3-pytest</test_depend>
  <!-- nav2_msgs is optional and deliberately not declared, not even for tests:
       Nav2 isn't released into every distro, and bloom needs every declared
       key. Without it the bt_log plugin stays inactive and its tests skip. -->

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
